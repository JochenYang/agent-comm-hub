{
  "$schema": "docs/agent-registry.schema.json",
  "agents": [
    {
      "id": "mcode",
      "probe": [],
      "probePaths": ["~/.minimax"],
      "configs": [
        {
          "file": "~/.minimax/mcp.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": {
            "url": "{url}",
            "type": "streamable-http",
            "enabled": true,
            "configured": true,
            "timeout": 120000,
            "description": "agent-comm-hub: talk to every other agent connected to the hub."
          }
        },
        {
          "file": "~/.minimax/mcp/mcp.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": {
            "url": "{url}",
            "type": "streamable-http",
            "enabled": true,
            "configured": true,
            "timeout": 120000,
            "description": "agent-comm-hub: talk to every other agent connected to the hub."
          }
        }
      ],
      "skill": "~/.minimax/skills",
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "opencode",
      "probe": ["opencode"],
      "probePaths": ["~/.config/opencode"],
      "npm": ["cli"],
      "configs": [
        {
          "file": "~/.config/opencode/opencode.json",
          "section": "mcp",
          "strategy": "json",
          "entry": { "type": "remote", "url": "{url}", "enabled": true }
        }
      ],
      "skill": "~/.config/opencode/skills",
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "kimi-code",
      "probe": ["kimi"],
      "probePaths": ["~/.kimi-code"],
      "configs": [
        {
          "file": "~/.kimi-code/mcp.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "url": "{url}", "startupTimeoutMs": 30000, "toolTimeoutMs": 120000 }
        }
      ],
      "skill": "~/.kimi-code/skills",
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "gemini-cli",
      "probe": ["gemini"],
      "probePaths": ["~/.gemini"],
      "configs": [
        {
          "file": "~/.gemini/settings.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "httpUrl": "{url}" }
        }
      ],
      "skill": "~/.gemini/skills",
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "codex",
      "probe": ["codex"],
      "probePaths": ["~/.codex"],
      "npm": ["codex"],
      "configs": [
        {
          "file": "~/.codex/config.toml",
          "section": null,
          "strategy": "toml",
          "entry": null
        }
      ],
      "skill": "~/.codex/skills",
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "zcode",
      "probe": [],
      "probePaths": ["~/.zcode"],
      "configs": [
        {
          "file": "~/.zcode/cli/config.json",
          "section": "mcp.servers",
          "strategy": "json",
          "entry": { "type": "remote", "url": "{url}", "enabled": true }
        }
      ],
      "skill": "~/.zcode/skills",
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "dsh",
      "probe": [],
      "probePaths": ["~/.dsh"],
      "serverName": "agent-comm-hub",
      "configs": [
        {
          "file": "~/.dsh/profiles/*/cordis.patch.yml",
          "section": null,
          "strategy": "dsh",
          "entry": null,
          "serverName": "agent-comm-hub"
        },
        {
          "file": "~/.dsh/cordis.patch.yml",
          "section": null,
          "strategy": "dsh",
          "entry": null,
          "serverName": "agent-comm-hub"
        }
      ],
      "skill": "~/.dsh/skills",
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "claude",
      "probe": ["claude"],
      "probePaths": ["~/.claude"],
      "npm": ["claude-code"],
      "configs": [],
      "skill": "~/.claude/skills",
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "qwen-code",
      "probe": ["qwen"],
      "probePaths": ["~/.qwen"],
      "npm": ["qwen-code"],
      "configs": [
        {
          "file": "~/.qwen/settings.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "httpUrl": "{url}" }
        }
      ],
      "skill": "~/.qwen/skills",
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "pi",
      "probe": ["pi"],
      "npm": ["pi-coding-agent"],
      "configs": [],
      "skill": "~/.agents/skills",
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "cursor",
      "probe": ["cursor", "cursor-agent"],
      "probePaths": ["~/.cursor"],
      "npm": ["cursor"],
      "configs": [
        {
          "file": "~/.cursor/mcp.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "url": "{url}" }
        }
      ],
      "skill": null,
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "qoder",
      "probe": ["qoder"],
      "npm": ["qoder"],
      "configs": [
        {
          "file": "~/.qoder/settings.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "type": "http", "url": "{url}" }
        }
      ],
      "skill": null,
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "codebuddy",
      "probe": ["codebuddy"],
      "npm": ["codebuddy"],
      "configs": [],
      "skill": null,
      "os": ["win32", "darwin", "linux"]
    },
    {
      "id": "claude-desktop",
      "probe": [],
      "probePaths": ["~/Library/Application Support/Claude", "~/AppData/Roaming/Claude"],
      "configs": [
        {
          "file": "~/Library/Application Support/Claude/claude_desktop_config.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "url": "{url}", "type": "streamable-http" },
          "os": ["darwin"]
        },
        {
          "file": "~/AppData/Roaming/Claude/claude_desktop_config.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "url": "{url}", "type": "streamable-http" },
          "os": ["win32"]
        }
      ],
      "skill": null,
      "os": ["darwin", "win32"]
    },
    {
      "id": "zed",
      "probe": ["zed"],
      "probePaths": ["~/.config/zed", "~/AppData/Roaming/Zed"],
      "configs": [
        {
          "file": "~/AppData/Roaming/Zed/settings.json",
          "section": "context_servers",
          "strategy": "json",
          "entry": { "url": "{url}" },
          "os": ["win32"]
        },
        {
          "file": "~/.config/zed/settings.json",
          "section": "context_servers",
          "strategy": "json",
          "entry": { "url": "{url}" },
          "os": ["darwin", "linux"]
        }
      ],
      "skill": null,
      "os": ["darwin", "win32", "linux"]
    },
    {
      "id": "amp",
      "probe": ["amp"],
      "probePaths": ["~/.config/amp"],
      "configs": [
        {
          "file": "~/.config/amp/settings.json",
          "section": "amp.mcpServers",
          "strategy": "json",
          "entry": { "url": "{url}" }
        }
      ],
      "skill": null,
      "os": ["darwin", "win32", "linux"]
    },
    {
      "id": "continue",
      "probe": ["cn"],
      "configs": [
        {
          "file": "~/.continue/config.yaml",
          "strategy": "yaml-array",
          "section": "mcpServers",
          "entry": { "name": "{serverName}", "type": "streamable-http", "url": "{url}" }
        }
      ],
      "skill": null,
      "os": ["darwin", "win32", "linux"]
    },
    {
      "id": "cline",
      "probe": [],
      "probePaths": [
        "~/AppData/Roaming/Code/User/globalStorage/saoudrizwan.claude-dev",
        "~/Library/Application Support/Code/User/globalStorage/saoudrizwan.claude-dev",
        "~/.config/Code/User/globalStorage/saoudrizwan.claude-dev"
      ],
      "configs": [
        {
          "file": "~/AppData/Roaming/Code/User/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "url": "{url}", "type": "streamableHttp" },
          "os": ["win32"]
        },
        {
          "file": "~/Library/Application Support/Code/User/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "url": "{url}", "type": "streamableHttp" },
          "os": ["darwin"]
        },
        {
          "file": "~/.config/Code/User/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "url": "{url}", "type": "streamableHttp" },
          "os": ["linux"]
        }
      ],
      "skill": null,
      "os": ["darwin", "win32", "linux"]
    },
    {
      "id": "roo-code",
      "probe": [],
      "probePaths": [
        "~/AppData/Roaming/Code/User/globalStorage/rooveterinaryinc.roo-cline",
        "~/Library/Application Support/Code/User/globalStorage/rooveterinaryinc.roo-cline",
        "~/.config/Code/User/globalStorage/rooveterinaryinc.roo-cline"
      ],
      "configs": [
        {
          "file": "~/AppData/Roaming/Code/User/globalStorage/rooveterinaryinc.roo-cline/settings/mcp_settings.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "url": "{url}", "type": "streamableHttp" },
          "os": ["win32"]
        },
        {
          "file": "~/Library/Application Support/Code/User/globalStorage/rooveterinaryinc.roo-cline/settings/mcp_settings.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "url": "{url}", "type": "streamableHttp" },
          "os": ["darwin"]
        },
        {
          "file": "~/.config/Code/User/globalStorage/rooveterinaryinc.roo-cline/settings/mcp_settings.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "url": "{url}", "type": "streamableHttp" },
          "os": ["linux"]
        }
      ],
      "skill": null,
      "os": ["darwin", "win32", "linux"]
    },
    {
      "id": "amazon-q",
      "probe": ["q", "qchat"],
      "probePaths": ["~/.aws/amazonq"],
      "configs": [
        {
          "file": "~/.aws/amazonq/cli-agents/*.json",
          "section": "mcpServers",
          "strategy": "json",
          "entry": { "type": "http", "url": "{url}" }
        }
      ],
      "skill": null,
      "os": ["darwin", "win32", "linux"]
    }
  ]
}
